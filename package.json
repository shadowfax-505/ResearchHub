{
  "name": "researchhub",
  "version": "1.0.0",
  "private": true,
  "description": "ResearchHub deployment configuration for Vercel and local development.",
  "scripts": {
    "dev": "cd api && npm run dev",
    "dev:web": "cd web && npm run dev",
    "start": "cd api && npm start",
    "start:web": "cd web && npm start",
    "build:web": "cd web && npm run build",
    "lint": "cd api && npm run lint && cd ../web && npm run lint",
    "lint:web": "cd web && npm run lint",
    "test": "cd api && npm test",
    "test:web:e2e": "cd web && npm run test:e2e",
    "install:all": "npm install && cd api && npm install && cd ../web && npm install",
    "vercel-build": "cd api && npm install && cd ../web && npm install && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "oracledb": "^6.7.2",
    "serverless-http": "^3.0.0"
  },
  "devDependencies": {
    "eslint": "^8.48.0",
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  }
}
